rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el repartidor (su usuario y su correo) puede leer y escribir sus datos.
    match /users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'josemanuelluzardo4@gmail.com';
      match /{sub=**} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email == 'josemanuelluzardo4@gmail.com';
      }
    }
  }
}
